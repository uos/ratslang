{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Ratslang",
  "scopeName": "source.rl",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#paths"
    },
    {
      "include": "#booleans"
    },
    {
      "include": "#quantities"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#internal-variables"
    },
    {
      "include": "#namespace-accessor"
    },
    {
      "include": "#unquoted-strings"
    },
    {
      "include": "#variables"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign",
          "match": "#[^\\n]*"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape",
          "match": "\\\\."
        }
      ]
    },
    "paths": {
      "name": "string.unquoted.path",
      "match": "\\.?/+[^\\n\\s]*"
    },
    "booleans": {
      "name": "constant.language.boolean",
      "match": "\\b(true|false)\\b"
    },
    "quantities": {
      "patterns": [
        {
          "name": "constant.numeric.quantity.time",
          "match": "(?<![\\w.])[+-]?(?:\\d+\\.\\d+|\\d+)(?:[eE][+-]?\\d+)?(?:shakes?|years?|minutes?|hours?|days?|seconds?_sidereal|days?_sidereal|hours?_sidereal|years?_sidereal|years?_tropical|ys|zs|as|fs|ps|ns|us|µs|ms|cs|ds|s|das|hs|ks|Ms|Gs|Ts|Ps|Es|Zs|Ys|min|h|d|a)(?![\\wµμÅ])"
        },
        {
          "name": "constant.numeric.quantity.length",
          "match": "(?<![\\w.])[+-]?(?:\\d+\\.\\d+|\\d+)(?:[eE][+-]?\\d+)?(?:astronomical_units?|nautical_miles?|light_years?|microinches?|bohr_radiuses?|ångströms?|astronomical_unit|nautical_mile|light_year|microinch|bohr_radius|ångström|angstroms?|angstrom|feet|inches|yards|miles|chains|rods|fathoms?|fermis?|fermi|microns?|micron|mils?|ym|zm|am|fm|pm|nm|um|µm|mm|cm|dm|dam|hm|km|Mm|Gm|Tm|Pm|Em|Zm|Ym|ft|in|mi|yd|ch|rd|ua|au|pc|l\\.y\\.|Å|µ|μm|m)(?![\\wµμÅ])"
        },
        {
          "name": "constant.numeric.quantity.mass",
          "match": "(?<![\\w.])[+-]?(?:\\d+\\.\\d+|\\d+)(?:[eE][+-]?\\d+)?(?:milligrams?|micrograms?|nanograms?|kilograms?|grams?|tonnes?|metric_ton|pounds?|ounces?|lb|oz|yg|zg|ag|fg|pg|ng|ug|µg|μg|mg|cg|dg|dag|hg|kg|Mg|Gg|Tg|Pg|Eg|Zg|Yg|g|t)(?![\\wµμÅ])"
        },
        {
          "name": "constant.numeric.quantity.angle",
          "match": "(?<![\\w.])[+-]?(?:\\d+\\.\\d+|\\d+)(?:[eE][+-]?\\d+)?(?:deg|rad|mrad|urad|µrad)(?![\\wµμÅ])"
        },
        {
          "name": "constant.numeric.quantity.frequency",
          "match": "(?<![\\w.])[+-]?(?:\\d+\\.\\d+|\\d+)(?:[eE][+-]?\\d+)?(?:mHz|Hz|kHz|MHz|GHz)(?![\\wµμÅ])"
        },
        {
          "name": "constant.numeric.quantity.velocity",
          "match": "(?<![\\w.])[+-]?(?:\\d+\\.\\d+|\\d+)(?:[eE][+-]?\\d+)?(?:m/s|cm/s|mm/s|km/h)(?![\\wµμÅ])"
        },
        {
          "name": "constant.numeric.quantity.acceleration",
          "match": "(?<![\\w.])[+-]?(?:\\d+\\.\\d+|\\d+)(?:[eE][+-]?\\d+)?(?:m/s2|m/s\\^2|cm/s2|cm/s\\^2|mm/s2|mm/s\\^2)(?![\\wµμÅ])"
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric",
      "match": "\\b[+-]?(\\d+\\.\\d+|\\d+)(?:[eE][+-]?\\d+)?\\b"
    },
    "internal-variables": {
      "name": "variable.language",
      "match": "\\b_[a-zA-Z_:\\d]+\\b(?!\\s*[.{])"
    },
    "namespace-accessor": {
      "name": "entity.name.namespace",
      "match": "\\b[a-zA-Z_:][a-zA-Z_:\\d]*(?=\\s*[.{])"
    },
    "unquoted-strings": {
      "patterns": [
        {
          "name": "entity.name.type",
          "match": "(?<=[=,\\[]\\s*)\\b[a-zA-Z:][a-zA-Z_:\\d]*(?:\\.[a-zA-Z:][a-zA-Z_:\\d]*)*\\b"
        }
      ]
    },
    "variables": {
      "name": "variable.other",
      "match": "\\b[a-zA-Z:][a-zA-Z_:\\d]*\\b"
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment",
          "match": "="
        },
        {
          "name": "keyword.operator.range",
          "match": "\\.\\."
        },
        {
          "name": "punctuation.separator.comma",
          "match": ","
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.definition.block",
          "match": "[{}]"
        },
        {
          "name": "punctuation.definition.array",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.accessor",
          "match": "\\."
        }
      ]
    }
  }
}
